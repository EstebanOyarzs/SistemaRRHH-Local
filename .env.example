# Copiar este archivo a .env y completar con los valores reales.
# .env nunca se versiona (ver .gitignore).
# JWT_SECRET_KEY se genera y agrega solo automaticamente (backend/config.py) - no la pongas aqui.

ENVIRONMENT=development

