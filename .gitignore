# Entornos virtuales
venv/
.venv/
__pycache__/
*.pyc

# Base de datos y datos locales
data/*.db
data/*.db-journal
data/reportes/*
!data/reportes/.gitkeep
data/uploads/*
!data/uploads/.gitkeep

# Dashboards: DB propia con datos normalizados + planillas de origen
# (contienen datos personales reales - RUT, nombres, sobretiempo por
# empleado - no se versionan)
Sobretiempo/data/*.db
Sobretiempo/data/*.db-journal
Sobretiempo/data/backups/
Sobretiempo/Archivos ejemplo/*.xlsx
Sobretiempo/Archivos ejemplo/*.pptx
Sobretiempo/Archivos ejemplo/*.html

Capacitacion/data/*.db
Capacitacion/data/*.db-journal
Capacitacion/data/backups/
Capacitacion/Archivos Ejemplo/*.xlsx

# Modelos IA (pesos, no versionar)
models/*
!models/.gitkeep

# OneDrive sync (contenido local, no versionar)
onedrive_sync/*
!onedrive_sync/.gitkeep

# Configuracion sensible
.env
*.env.local
*.pem
*.key

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Logs
*.log
